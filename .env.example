# Supabase Project Settings > API에서 확인합니다. URL과 anon key는 공개 클라이언트 값입니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# 서버 전용 비밀키입니다. NEXT_PUBLIC_ 접두사를 붙이거나 브라우저 코드에서 사용하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# 공용 회원 접속코드입니다. 개인 식별 없이 게시판·프로젝트 기능을 사용합니다.
INVITE_CODE=change-this-invite-code

# 선택 사항: 개인 회원 코드에서 이름 뒤에 붙는 서버 전용 값입니다. 없으면 INVITE_CODE를 사용합니다.
MEMBER_PIN_SUFFIX=change-this-member-pin-suffix

# 관리자 전체 편집용 접속코드입니다. 회원 코드와 다르게 설정하세요.
ADMIN_ACCESS_CODE=change-this-admin-code

# 32자 이상의 무작위 문자열을 권장합니다. 세션 쿠키 서명에 사용됩니다.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
